{
  "name": "keuzewijzeraardgasvrij-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "acc": "vite --mode acceptance",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepare": "node -e \"try{require.resolve('husky')}catch(e){process.exit(0)}\" && husky"
  },
  "dependencies": {
    "@amsterdam/design-system-assets": "^2.6.0",
    "@amsterdam/design-system-css": "^4.4.0",
    "@amsterdam/design-system-react": "^4.4.0",
    "@amsterdam/design-system-react-icons": "^2.2.0",
    "@amsterdam/design-system-tokens": "^4.3.0",
    "@amsterdam/ee-ads-rhf": "^0.0.6",
    "@hookform/resolvers": "^5.9.1",
    "@react-pdf/renderer": "^4.9.0",
    "@tanstack/react-query": "^5.102.8",
    "qs": "^6.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-tooltip": "^6.0.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/qs": "^6.15.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "eslint --cache --fix",
      "prettier --write"
    ]
  }
}
